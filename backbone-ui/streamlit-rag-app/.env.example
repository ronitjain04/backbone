# Ollama (required for answer generation)
LOCAL_OLLAMA_SERVER=http://localhost:11434
OLLAMA_TIMEOUT=120
OLLAMA_MODEL=mistral
OLLAMA_NUM_PREDICT=2048

# RAG retrieval
RAG_TOP_K=10
MIN_SIMILARITY=0.20

# API
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000
MAX_QUERY_LENGTH=2000
RATE_LIMIT_MAX=10
RATE_LIMIT_WINDOW=60

# Optional: suppress HF Hub rate-limit warning when loading sentence-transformers
# HF_TOKEN=your_huggingface_token

# Optional: for app2 / research PDF flow (arxiv, Springer) only
# SPRINGER_API_KEY=your_springer_api_key
