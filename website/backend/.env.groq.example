# Groq free-tier demo configuration. Supply a fresh key privately on Render.
MODEL_PROVIDER=compatible
MODEL_BASE_URL=https://api.groq.com/openai/v1
MODEL_NAME=openai/gpt-oss-20b
# Set MODEL_API_KEY directly in Render; do not put a real value in this file.
MODEL_API_KEY=
CORPUS_PATH=website/backend/data/demo.jsonl
RETRIEVAL_MODE=lexical
