# Server-side only. Never put these values in browser files.
CORPUS_PATH=website/backend/data/demo.jsonl
# Optional course-specific paths. CORPUS_PATH remains the CS 2200 fallback.
CS2110_CORPUS_PATH=
CS2200_CORPUS_PATH=
RETRIEVAL_MODE=lexical
# compatible: URL must include the provider's API version path, e.g. https://provider.example/v1
# ollama: URL is the Ollama origin, e.g. http://127.0.0.1:11434
MODEL_PROVIDER=compatible
MODEL_BASE_URL=
MODEL_NAME=
MODEL_API_KEY=
# Required for a hosted API. Configure the same value as BACKEND_TOKEN in Sites.
BACKEND_TOKEN=
